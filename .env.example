# cp .env.example .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore 로 막혀 있다.
# ./run.sh run 이 읽는다. 같은 이름으로 export 된 값이 있으면 그쪽이 우선이다.
AI_API_KEY=

# 선택. Anthropic 규격(/v1/messages)을 제공하는 곳의 도메인까지만 적는다 (예: https://api.example.com).
# 비우면 공식 도메인(https://api.anthropic.com). /v1/messages 는 도구가 붙인다.
# 바꾸면 API Key 가 이 주소로 전송된다 — https 만 허용 (http 는 localhost·127.0.0.1·::1 만).
AI_API_BASE_URL=

# 선택. API 호출 기록(JSONL, 호출 1회 = 한 줄)을 남길 파일. 비우면 남기지 않는다.
# 상대 경로는 이 도구 디렉터리 기준 (예: logs/calls.jsonl). logs/ 와 *.jsonl 은 .gitignore 대상.
# 요청 바디(프롬프트·safe-mode 적용 후 diff)와 응답 원문이 들어간다. API Key 는 넣지 않는다.
AI_LOG_FILE=
